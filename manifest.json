{
  "manifest_version": 3,
  "name": "AdBlocker Pro Ultimate",
  "version": "5.4.4",
  "description": "Block annoying ads on YouTube and Facebook cleanly. Core community filter lists, Facebook & Instagram detection, YouTube instant-start, Twitter/X promoted tweet slayer, Popunder neutralizer, and safe anti-adblock evasion.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ad Blocker Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ublock-filters",
        "enabled": true,
        "path": "rulesets/main/ublock-filters.json"
      },
      {
        "id": "easylist",
        "enabled": true,
        "path": "rulesets/main/easylist.json"
      },
      {
        "id": "easyprivacy",
        "enabled": true,
        "path": "rulesets/main/easyprivacy.json"
      },
      {
        "id": "pgl",
        "enabled": true,
        "path": "rulesets/main/pgl.json"
      },
      {
        "id": "ublock-badware",
        "enabled": true,
        "path": "rulesets/main/ublock-badware.json"
      },
      {
        "id": "urlhaus-full",
        "enabled": true,
        "path": "rulesets/main/urlhaus-full.json"
      },
      {
        "id": "ads",
        "enabled": true,
        "path": "rules_ads.json"
      },
      {
        "id": "tracking",
        "enabled": true,
        "path": "rules_tracking.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "web_accessible_resources/1x1.gif",
        "web_accessible_resources/2x2.png",
        "web_accessible_resources/32x32.png",
        "web_accessible_resources/adthrive_abd.js",
        "web_accessible_resources/amazon_ads.js",
        "web_accessible_resources/amazon_apstag.js",
        "web_accessible_resources/chartbeat.js",
        "web_accessible_resources/doubleclick_instream_ad_status.js",
        "web_accessible_resources/empty",
        "web_accessible_resources/fingerprint2.js",
        "web_accessible_resources/fingerprint3.js",
        "web_accessible_resources/google-analytics_analytics.js",
        "web_accessible_resources/google-analytics_cx_api.js",
        "web_accessible_resources/google-analytics_ga.js",
        "web_accessible_resources/google-ima.js",
        "web_accessible_resources/googlesyndication_adsbygoogle.js",
        "web_accessible_resources/googletagservices_gpt.js",
        "web_accessible_resources/hd-main.js",
        "web_accessible_resources/nitropay_ads.js",
        "web_accessible_resources/nobab2.js",
        "web_accessible_resources/nofab.js",
        "web_accessible_resources/noop-0.1s.mp3",
        "web_accessible_resources/noop-1s.mp4",
        "web_accessible_resources/noop-vast2.xml",
        "web_accessible_resources/noop-vast3.xml",
        "web_accessible_resources/noop-vmap1.xml",
        "web_accessible_resources/noop.css",
        "web_accessible_resources/noop.html",
        "web_accessible_resources/noop.js",
        "web_accessible_resources/noop.json",
        "web_accessible_resources/noop.txt",
        "web_accessible_resources/outbrain-widget.js",
        "web_accessible_resources/popads.js",
        "web_accessible_resources/prebid-ads.js",
        "web_accessible_resources/scorecardresearch_beacon.js",
        "web_accessible_resources/sensors-analytics.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "popclose.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "match_about_blank": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.messenger.com/*"
      ],
      "js": [
        "fb-net-probe.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.messenger.com/*"
      ],
      "js": [
        "fb-detect.js",
        "facebook.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "instagram.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.twitter.com/*",
        "*://*.x.com/*"
      ],
      "js": [
        "twitter.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "minimum_chrome_version": "119"
}
